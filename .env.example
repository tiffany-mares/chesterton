# Chesterton — environment configuration (see docs/contracts.md)
CHESTERTON_MODE=mock

# Service ports / URLs
GATEWAY_URL=http://localhost:4000
MOCKS_URL=http://localhost:4100
ANALYZER_URL=http://localhost:4200
VERDICT_URL=http://localhost:4300
LEDGER_URL=http://localhost:4400
TRIAGE_URL=http://localhost:4500

# External systems (mock defaults; switch for real mode)
ESTELLE_URL=http://localhost:4100/estelle
ESTELLE_API_KEY=
GITHUB_API_URL=http://localhost:4100/github/api
GITHUB_WEBHOOK_SECRET=devsecret
GITHUB_TOKEN=

# GitHub App auth (real mode; overrides GITHUB_TOKEN when all three are set —
# check runs require an App installation token, a classic PAT cannot create them)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Verdict timeouts (integer seconds; raise for a real LLM-backed Estelle)
VERDICT_HTTP_TIMEOUT_SECONDS=20
VERDICT_JUDGE_TIMEOUT_SECONDS=30

# Real-mode credentials (unused in mock mode)
SLACK_BOT_TOKEN=
# Channel ID (not name) of the #oncall-style channel the bot posts to —
# chat.getPermalink requires an ID. The bot can create the channel itself
# given channels:manage.
SLACK_CHANNEL_ID=
LINEAR_API_KEY=
# issueCreate requires a teamId; resolve via the GraphQL teams query.
LINEAR_TEAM_ID=
# Real demo repo URL; when set, seeded pr-type citations become
# {REAL_REPO_URL}/commit/{sha} links instead of mock PR pages.
REAL_REPO_URL=

# Storage (all optional — services fall back to in-memory/file)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://chesterton:chesterton@localhost:5432/chesterton
MONGO_URL=mongodb://localhost:27017/chesterton
