# Chesterton — environment configuration (see docs/contracts.md)
CHESTERTON_MODE=mock

# Service ports / URLs
GATEWAY_URL=http://localhost:4000
MOCKS_URL=http://localhost:4100
ANALYZER_URL=http://localhost:4200
VERDICT_URL=http://localhost:4300
LEDGER_URL=http://localhost:4400
TRIAGE_URL=http://localhost:4500

# External systems (mock defaults; switch for real mode)
ESTELLE_URL=http://localhost:4100/estelle
GITHUB_API_URL=http://localhost:4100/github/api
GITHUB_WEBHOOK_SECRET=devsecret
GITHUB_TOKEN=

# Real-mode credentials (unused in mock mode)
SLACK_BOT_TOKEN=
LINEAR_API_KEY=

# Storage (all optional — services fall back to in-memory/file)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://chesterton:chesterton@localhost:5432/chesterton
MONGO_URL=mongodb://localhost:27017/chesterton
